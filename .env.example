# Danh sach API key Gemini, tach nhau bang dau phay de tu dong xoay vong khi gap 429/503/quota
# Tren GitHub Actions: khai bao cung ten GEMINI_API_KEYS trong Settings -> Secrets and variables -> Actions
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Du phong neu chi dung 1 key duy nhat
# GEMINI_API_KEY=your_single_gemini_key

# Model Gemini mac dinh (ho tro Google Search Grounding)
GEMINI_MODEL=gemini-flash-latest

# Danh sach model du phong (tuy chon), uu tien Flash on dinh & chi dung Pro lam phuong an cuoi cung
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest,gemini-flash-lite-latest,gemini-pro-latest

# Danh sach model tao anh boi canh minh hoa AI (v3.0, ho tro ca Gemini generateContent inlineData lan Imagen predict)
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,imagen-3.0-generate-002,gemini-2.0-flash-exp-image-generation

# Giong doc Edge TTS mac dinh (fallback cho kich ban cu khong co nhan vaiNoi)
TTS_VOICE=vi-VN-NamMinhNeural

# Phan vai da giong Edge TTS (v0.7) — ho tro 2-3 giong tieng Viet khac nhau + toc do/cao do rieng
TTS_VOICE_NGUOI_DAN=vi-VN-NamMinhNeural
TTS_VOICE_NHAN_VAT=vi-VN-HoaiMyNeural
TTS_VOICE_BINH_LUAN_HAI=vi-VN-HoaiMyNeural

# Tuy chon dieu chinh nhe toc do (rate) va cao do (pitch) theo tung vai noi hoac tung nhan vat
# TTS_RATE_NGUOI_DAN=+0%
# TTS_PITCH_NGUOI_DAN=+0Hz
# TTS_RATE_NHAN_VAT=-3%
# TTS_PITCH_NHAN_VAT=+2Hz
# TTS_RATE_BINH_LUAN_HAI=+6%
# TTS_PITCH_BINH_LUAN_HAI=+4Hz
# TTS_VOICE_NHAN_VAT_EULER=vi-VN-NamMinhNeural
# TTS_RATE_NHAN_VAT_EULER=-5%
# TTS_PITCH_NHAN_VAT_EULER=-6Hz

# Tuy chon tuy chinh ho so Mascot dan chuyen co dinh cua kenh (v3.5) — KHONG bat buoc
# Mac dinh: id=mascot_pi, ten="Giáo Sư Pi", trangPhuc=ao_choang_hoc_gia, kieuToc=mu_noi, mauAo=#0284C7
# MASCOT_TEN=Giáo Sư Pi
# MASCOT_TRANG_PHUC=ao_choang_hoc_gia
# MASCOT_KIEU_TOC=mu_noi
# MASCOT_MAU_AO=#0284C7

# Tuy chon tu dong dang video + hen gio cong khai len YouTube Data API v3 (stdlib, KHONG bat buoc)
# Chay 1 lan tren may ca nhan de lay Refresh Token trong 30 giay:
#   python -X utf8 scripts/pipeline/lay_refresh_token_youtube.py
# Tren GitHub Actions: khai bao 3 Secrets cung ten trong Settings -> Secrets and variables -> Actions.
# Neu bo trong bat ky bien nao, dang_youtube.py se in huong dan va thoat an toan (ma 0), khong fail workflow.
# YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
# YOUTUBE_REFRESH_TOKEN=your_youtube_oauth_refresh_token

# Tuy chon dong bo so lieu YouTube Data API v3 (v1.0) — KHONG bat buoc
# Neu de trong, dung file CSV/JSON xuat tay tu YouTube Studio voi:
#   python -X utf8 scripts/pipeline/bo_nho_hoc_hoi.py --nhap-so-lieu-youtube --file-so-lieu <file>
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# YOUTUBE_OAUTH_TOKEN=your_optional_youtube_oauth_access_token

{
  "name": "video-dai-nguoi-que-toan-hoc",
  "version": "2.0.0",
  "private": true,
  "description": "He thong AI tu chu san xuat phim hoat hinh 2D ke chuyen lich su Toan hoc >10 phut (Remotion + Python)",
  "scripts": {
    "dev": "remotion studio",
    "kiem-tra": "npx tsc --noEmit && node scripts/test_khung.mjs",
    "kiem-tra:all": "npm run kiem-tra && python -X utf8 scripts/test_pipeline.py",
    "san-xuat:tu-dong": "python -X utf8 scripts/pipeline/san_xuat_lien_tuc.py",
    "render:mau": "remotion render src/index.ts VideoDaiNguoiQue out/mau_pythagoras.mp4 --props=du_lieu/mau_pythagoras.json"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "katex": "^0.16.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
